# APP
NODE_ENV=production
PORT=8000
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,*.vercel.app
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
APP_BASE_URL=https://your-domain.com
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=60
GOOGLE_CLIENT_ID=
# Brevo SMTP (Transactional)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM="BookIn <no-reply@your-domain.com>"
SMTP_SECURE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_API_BASE_URL=https://api.xendit.co
XENDIT_INVOICE_EXPIRY_MINUTES=30
BOOKING_PAYMENT_DUE_MINUTES=120
BOOKING_PROOF_UPLOAD_DUE_MINUTES=60

# DB
POSTGRES_LOCAL_PASSWORD=yourpass
DATABASE_URL="postgresql://postgres:yourpass@postgres:5432/postgres"
DIRECT_URL="postgresql://postgres:yourpass@postgres:5432/postgres"
