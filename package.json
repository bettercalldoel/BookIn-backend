{
  "name": "express-prisma",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npx prisma generate && tsc",
    "test": "node scripts/test-runner.mjs unit",
    "test:integration": "node scripts/test-runner.mjs integration",
    "start": "node dist/src/index.js",
    "dev": "tsx --watch src/index.ts",
    "dev:local-db": "DATABASE_URL=postgresql://postgres:admin@localhost:6543/postgres DIRECT_URL=postgresql://postgres:admin@localhost:6543/postgres npm run dev",
    "db:inspect": "node scripts/db-inspect.mjs",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "db:migrate-remote-to-local": "node scripts/db-migrate-remote-to-local.mjs",
    "db:sync:dev": "LOCAL_POSTGRES_CONTAINER=postgres_container_dev node scripts/db-migrate-remote-to-local.mjs",
    "db:backfill:property-coordinates": "node scripts/backfill-property-coordinates.mjs",
    "docker-dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker-dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker-prod:up": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build",
    "docker-prod:down": "docker compose --env-file .env.prod -f docker-compose.prod.yml down",
    "docker-prod:logs": "docker compose --env-file .env.prod -f docker-compose.prod.yml logs -f",
    "check:standardization": "node ../scripts/standardization-check.mjs",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "prepare": "husky",
    "deploy:railway": "./scripts/deploy-railway.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.5",
    "@types/pg": "^8.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/nodemailer": "^7.0.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3",
    "pino": "^10.1.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "overrides": {
    "@prisma/dev": {
      "hono": "4.11.9",
      "@mrleebo/prisma-ast": "0.14.0"
    }
  }
}
